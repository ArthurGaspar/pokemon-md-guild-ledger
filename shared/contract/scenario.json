{
  "about": "Executed step by step against the Spring API (ContractScenarioTest) and the in-browser engine (contract.test.ts). Paths use {var} placeholders filled from earlier 'save' entries. JSON paths: $.a.b, [n] indexes, trailing # for length.",
  "steps": [
    { "name": "register the founder", "method": "POST", "path": "/api/auth/register",
      "body": { "username": "mira", "displayName": "Mira", "password": "lantern-123", "speciesId": 447 },
      "expect": { "status": 201, "json": { "$.user.username": "mira", "$.user.speciesId": 447 } },
      "save": { "token:mira": "$.token" } },
    { "name": "register a second explorer", "method": "POST", "path": "/api/auth/register",
      "body": { "username": "teo", "displayName": "Teo", "password": "lantern-123", "speciesId": 158 },
      "expect": { "status": 201 }, "save": { "token:teo": "$.token" } },
    { "name": "register a third explorer", "method": "POST", "path": "/api/auth/register",
      "body": { "username": "sol", "displayName": "Sol", "password": "lantern-123", "speciesId": 152 },
      "expect": { "status": 201 }, "save": { "token:sol": "$.token" } },
    { "name": "usernames are unique regardless of case", "method": "POST", "path": "/api/auth/register",
      "body": { "username": "MIRA", "displayName": "Other", "password": "lantern-123", "speciesId": 25 },
      "expect": { "status": 409, "code": "auth.username-taken" } },
    { "name": "every explorer is a Pokémon", "method": "POST", "path": "/api/auth/register",
      "body": { "username": "ghost", "displayName": "Ghost", "password": "lantern-123", "speciesId": 9999 },
      "expect": { "status": 422, "code": "species.unknown" } },
    { "name": "species is required", "method": "POST", "path": "/api/auth/register",
      "body": { "username": "ghost", "displayName": "Ghost", "password": "lantern-123" },
      "expect": { "status": 400, "code": "validation" } },
    { "name": "wrong password", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "mira", "password": "nope-nope" },
      "expect": { "status": 401, "code": "auth.bad-credentials" } },
    { "name": "login", "method": "POST", "path": "/api/auth/login",
      "body": { "username": "mira", "password": "lantern-123" },
      "expect": { "status": 200 }, "save": { "token:mira": "$.token" } },
    { "name": "Sol picks a different Pokémon", "as": "sol", "method": "PATCH", "path": "/api/me",
      "body": { "displayName": "Sol", "speciesId": 194 },
      "expect": { "status": 200, "json": { "$.speciesId": 194, "$.displayName": "Sol" } } },
    { "name": "no token, no data", "method": "GET", "path": "/api/me", "expect": { "status": 401 } },

    { "name": "found a team", "as": "mira", "method": "POST", "path": "/api/teams",
      "body": { "name": "Team Lanterna" },
      "expect": { "status": 201, "json": { "$.rank": "NORMAL", "$.myRole": "LEADER", "$.treasury": 0, "$.bagCap": 8 } },
      "save": { "team": "$.id", "miraM": "$.myMembershipId" } },
    { "name": "team names are unique", "as": "teo", "method": "POST", "path": "/api/teams",
      "body": { "name": "team lanterna" }, "expect": { "status": 409, "code": "team.name-taken" } },
    { "name": "outsiders can't see the team", "as": "teo", "method": "GET", "path": "/api/teams/{team}",
      "expect": { "status": 404, "code": "team.not-found" } },

    { "name": "leader invites an officer", "as": "mira", "method": "POST", "path": "/api/teams/{team}/invitations",
      "body": { "username": "teo", "role": "OFFICER" },
      "expect": { "status": 201, "json": { "$.status": "PENDING", "$.role": "OFFICER" } }, "save": { "invTeo": "$.id" } },
    { "name": "one pending invitation per person", "as": "mira", "method": "POST", "path": "/api/teams/{team}/invitations",
      "body": { "username": "teo", "role": "MEMBER" }, "expect": { "status": 409, "code": "invite.pending-exists" } },
    { "name": "invitee sees it", "as": "teo", "method": "GET", "path": "/api/invitations",
      "expect": { "status": 200, "json": { "$#": 1, "$[0].teamName": "Team Lanterna", "$[0].invitedBy.username": "mira" } } },
    { "name": "accept", "as": "teo", "method": "POST", "path": "/api/invitations/{invTeo}/accept",
      "expect": { "status": 200 } },
    { "name": "an accepted invitation can't be reused", "as": "teo", "method": "POST", "path": "/api/invitations/{invTeo}/decline",
      "expect": { "status": 409, "code": "invite.not-pending" } },
    { "name": "officers can't invite officers", "as": "teo", "method": "POST", "path": "/api/teams/{team}/invitations",
      "body": { "username": "sol", "role": "OFFICER" }, "expect": { "status": 403, "code": "team.forbidden" } },
    { "name": "officers can invite members", "as": "teo", "method": "POST", "path": "/api/teams/{team}/invitations",
      "body": { "username": "sol", "role": "MEMBER" }, "expect": { "status": 201 }, "save": { "invSol": "$.id" } },
    { "name": "someone else can't accept it", "as": "mira", "method": "POST", "path": "/api/invitations/{invSol}/accept",
      "expect": { "status": 404 } },
    { "name": "sol joins", "as": "sol", "method": "POST", "path": "/api/invitations/{invSol}/accept", "expect": { "status": 200 } },
    { "name": "roster of three", "as": "sol", "method": "GET", "path": "/api/teams/{team}/members",
      "expect": { "status": 200, "json": { "$#": 3, "$[0].role": "LEADER", "$[1].role": "OFFICER", "$[2].role": "MEMBER", "$[0].speciesId": 447, "$[2].speciesId": 194 } },
      "save": { "teoM": "$[1].membershipId", "solM": "$[2].membershipId" } },

    { "name": "Mira recruits Pikachu", "as": "mira", "method": "POST", "path": "/api/teams/{team}/recruits",
      "body": { "speciesId": 25, "nickname": "Volt", "level": 5 },
      "expect": { "status": 201, "json": { "$.speciesName": "Pikachu", "$.exp": 125, "$.nextLevelExp": 216, "$.status": "AVAILABLE" } },
      "save": { "r1": "$.id" } },
    { "name": "Sol recruits Mudkip", "as": "sol", "method": "POST", "path": "/api/teams/{team}/recruits",
      "body": { "speciesId": 258, "level": 4 }, "expect": { "status": 201 }, "save": { "r2": "$.id" } },
    { "name": "Teo recruits Machop", "as": "teo", "method": "POST", "path": "/api/teams/{team}/recruits",
      "body": { "speciesId": 66, "level": 6 }, "expect": { "status": 201 }, "save": { "r3": "$.id" } },
    { "name": "unknown species", "as": "teo", "method": "POST", "path": "/api/teams/{team}/recruits",
      "body": { "speciesId": 9999, "level": 6 }, "expect": { "status": 422, "code": "species.unknown" } },
    { "name": "members can't release others' recruits", "as": "sol", "method": "DELETE", "path": "/api/teams/{team}/recruits/{r1}",
      "expect": { "status": 403 } },

    { "name": "stock storage", "as": "sol", "method": "POST", "path": "/api/teams/{team}/storage/deposit",
      "body": { "itemCode": "oran-berry", "quantity": 3 }, "expect": { "status": 204 } },
    { "name": "stock a seed", "as": "sol", "method": "POST", "path": "/api/teams/{team}/storage/deposit",
      "body": { "itemCode": "reviver-seed", "quantity": 2 }, "expect": { "status": 204 } },
    { "name": "stock apples", "as": "sol", "method": "POST", "path": "/api/teams/{team}/storage/deposit",
      "body": { "itemCode": "apple", "quantity": 2 }, "expect": { "status": 204 } },
    { "name": "unknown item", "as": "sol", "method": "POST", "path": "/api/teams/{team}/storage/deposit",
      "body": { "itemCode": "master-ball", "quantity": 1 }, "expect": { "status": 422, "code": "item.unknown" } },
    { "name": "members can't discard", "as": "sol", "method": "POST", "path": "/api/teams/{team}/storage/discard",
      "body": { "itemCode": "apple", "quantity": 1 }, "expect": { "status": 403 } },

    { "name": "members can't post jobs", "as": "sol", "method": "POST", "path": "/api/teams/{team}/missions",
      "body": { "title": "x", "kind": "RESCUE", "dungeonCode": "beach-cave", "floor": 2, "difficulty": "E", "rewardPoke": 10 },
      "expect": { "status": 403 } },
    { "name": "Normal Rank can't take B jobs", "as": "mira", "method": "POST", "path": "/api/teams/{team}/missions",
      "body": { "title": "Too hard", "kind": "OUTLAW", "dungeonCode": "mt-horn", "floor": 10, "difficulty": "B", "rewardPoke": 600 },
      "expect": { "status": 422, "code": "mission.difficulty-locked" } },
    { "name": "floor must exist", "as": "mira", "method": "POST", "path": "/api/teams/{team}/missions",
      "body": { "title": "Deep", "kind": "SEARCH", "dungeonCode": "beach-cave", "floor": 9, "difficulty": "E", "rewardPoke": 100 },
      "expect": { "status": 422, "code": "mission.floor-out-of-range" } },
    { "name": "post a rescue", "as": "mira", "method": "POST", "path": "/api/teams/{team}/missions",
      "body": { "title": "Shellos stranded on B4F", "kind": "RESCUE", "dungeonCode": "beach-cave", "floor": 4,
                "difficulty": "D", "clientSpeciesId": 422, "rewardPoke": 300,
                "rewardItems": [{ "itemCode": "blast-seed", "quantity": 1 }] },
      "expect": { "status": 201, "json": { "$.status": "POSTED", "$.rankPoints": 15, "$.floorLabel": "B4F", "$.clientName": "Shellos" } },
      "save": { "mA": "$.id" } },

    { "name": "bag over capacity", "as": "teo", "method": "PUT", "path": "/api/teams/{team}/missions/{mA}/plan",
      "body": { "leaderMembershipId": "{teoM}", "recruitIds": ["{r1}"], "bag": [{ "itemCode": "apple", "quantity": 9 }] },
      "expect": { "status": 422, "code": "bag.over-capacity" } },
    { "name": "can't pack what storage lacks", "as": "teo", "method": "PUT", "path": "/api/teams/{team}/missions/{mA}/plan",
      "body": { "leaderMembershipId": "{teoM}", "recruitIds": ["{r1}"], "bag": [{ "itemCode": "oran-berry", "quantity": 5 }] },
      "expect": { "status": 422, "code": "ledger.insufficient-stock" } },
    { "name": "party of five is too big", "as": "teo", "method": "PUT", "path": "/api/teams/{team}/missions/{mA}/plan",
      "body": { "leaderMembershipId": "{teoM}", "recruitIds": ["{r1}", "{r2}", "{r3}", "{r1}", "{r2}"], "bag": [] },
      "expect": { "status": 422, "code": "party.size" } },
    { "name": "plan the rescue", "as": "teo", "method": "PUT", "path": "/api/teams/{team}/missions/{mA}/plan",
      "body": { "leaderMembershipId": "{teoM}", "recruitIds": ["{r1}", "{r2}"],
                "bag": [{ "itemCode": "oran-berry", "quantity": 3 }, { "itemCode": "reviver-seed", "quantity": 1 }, { "itemCode": "apple", "quantity": 2 }] },
      "expect": { "status": 200, "json": { "$.status": "PLANNED", "$.leader.displayName": "Teo", "$.leader.speciesId": 158, "$.party#": 2, "$.bag#": 3 } } },
    { "name": "payout preview: 20% treasury, equal split among Teo, Mira and Sol", "as": "sol", "method": "GET",
      "path": "/api/teams/{team}/missions/{mA}/payout-preview",
      "expect": { "status": 200, "json": { "$.treasury": 60, "$.shares#": 3, "$.shares[0].amount": 80, "$.shares[1].amount": 80,
                                            "$.shares[2].amount": 80, "$.shares[1].speciesId": 158, "$.expPerRecruit": 150, "$.levelUps#": 2 } } },
    { "name": "planned recruits can't be released", "as": "mira", "method": "DELETE", "path": "/api/teams/{team}/recruits/{r1}",
      "expect": { "status": 409, "code": "recruit.busy" } },
    { "name": "only the mission leader or an officer departs", "as": "sol", "method": "POST",
      "path": "/api/teams/{team}/missions/{mA}/depart", "expect": { "status": 403 } },
    { "name": "depart", "as": "teo", "method": "POST", "path": "/api/teams/{team}/missions/{mA}/depart",
      "expect": { "status": 200, "json": { "$.status": "DEPARTED" } } },
    { "name": "the bag left storage", "as": "sol", "method": "GET", "path": "/api/teams/{team}/storage",
      "expect": { "status": 200, "json": { "$.items#": 1, "$.items[0].itemCode": "reviver-seed", "$.items[0].quantity": 1,
                                            "$.inTheField#": 1, "$.inTheField[0].items#": 3 } } },
    { "name": "can't report more than was packed", "as": "teo", "method": "POST", "path": "/api/teams/{team}/missions/{mA}/report",
      "body": { "outcome": "COMPLETED", "itemsUsed": [{ "itemCode": "oran-berry", "quantity": 4 }] },
      "expect": { "status": 422, "code": "report.used-exceeds-bag" } },
    { "name": "report success, two berries eaten", "as": "teo", "method": "POST", "path": "/api/teams/{team}/missions/{mA}/report",
      "body": { "outcome": "COMPLETED", "itemsUsed": [{ "itemCode": "oran-berry", "quantity": 2 }], "note": "Shellos is home" },
      "expect": { "status": 200, "json": { "$.status": "COMPLETED", "$.outcomeNote": "Shellos is home" } } },
    { "name": "a closed mission can't be reported twice", "as": "teo", "method": "POST", "path": "/api/teams/{team}/missions/{mA}/report",
      "body": { "outcome": "FAILED" }, "expect": { "status": 409, "code": "mission.bad-status" } },
    { "name": "leftovers and reward are in storage", "as": "sol", "method": "GET", "path": "/api/teams/{team}/storage",
      "expect": { "status": 200, "json": { "$.items#": 4, "$.treasury": 60, "$.myWallet": 80, "$.inTheField#": 0 } } },
    { "name": "wallets got 80 each", "as": "mira", "method": "GET", "path": "/api/teams/{team}/members",
      "expect": { "status": 200, "json": { "$[0].wallet": 80, "$[1].wallet": 80, "$[2].wallet": 80 } } },
    { "name": "rank points counted", "as": "mira", "method": "GET", "path": "/api/teams/{team}",
      "expect": { "status": 200, "json": { "$.rankPoints": 15, "$.treasury": 60, "$.nextRank.code": "BRONZE" } } },
    { "name": "party gained exp and came home", "as": "mira", "method": "GET", "path": "/api/teams/{team}/recruits",
      "expect": { "status": 200, "json": { "$[0].level": 6, "$[0].exp": 275, "$[0].status": "AVAILABLE", "$[1].level": 5 } } },

    { "name": "post an easy job", "as": "teo", "method": "POST", "path": "/api/teams/{team}/missions",
      "body": { "title": "Fetch a Gravelerock", "kind": "SEARCH", "dungeonCode": "drenched-bluff", "floor": 7,
                "difficulty": "E", "rewardPoke": 100 },
      "expect": { "status": 201 }, "save": { "mB": "$.id" } },
    { "name": "Sol leads it", "as": "teo", "method": "PUT", "path": "/api/teams/{team}/missions/{mB}/plan",
      "body": { "leaderMembershipId": "{solM}", "recruitIds": ["{r3}"], "bag": [{ "itemCode": "reviver-seed", "quantity": 2 }] },
      "expect": { "status": 200 } },
    { "name": "the mission leader can depart", "as": "sol", "method": "POST", "path": "/api/teams/{team}/missions/{mB}/depart",
      "expect": { "status": 200 } },
    { "name": "a recruit can't be in two parties", "as": "teo", "method": "POST", "path": "/api/teams/{team}/missions",
      "body": { "title": "Second job", "kind": "DELIVERY", "dungeonCode": "beach-cave", "floor": 1, "difficulty": "E", "rewardPoke": 50 },
      "expect": { "status": 201 }, "save": { "mC": "$.id" } },
    { "name": "Machop is out", "as": "teo", "method": "PUT", "path": "/api/teams/{team}/missions/{mC}/plan",
      "body": { "leaderMembershipId": "{teoM}", "recruitIds": ["{r3}"], "bag": [] },
      "expect": { "status": 409, "code": "party.recruit-busy" } },
    { "name": "take the extra job down", "as": "teo", "method": "POST", "path": "/api/teams/{team}/missions/{mC}/cancel",
      "expect": { "status": 200, "json": { "$.status": "CANCELLED" } } },
    { "name": "the party fainted", "as": "sol", "method": "POST", "path": "/api/teams/{team}/missions/{mB}/report",
      "body": { "outcome": "FAILED", "note": "Ambushed on 6F" }, "expect": { "status": 200, "json": { "$.status": "FAILED" } } },
    { "name": "the seeds were lost, no reward", "as": "sol", "method": "GET", "path": "/api/teams/{team}/storage",
      "expect": { "status": 200, "json": { "$.items#": 3, "$.treasury": 60 } } },

    { "name": "Sol puts 30 in the treasury", "as": "sol", "method": "POST", "path": "/api/teams/{team}/treasury/contribute",
      "body": { "amount": 30 }, "expect": { "status": 204 } },
    { "name": "officers can't pay out", "as": "teo", "method": "POST", "path": "/api/teams/{team}/treasury/payout",
      "body": { "membershipId": "{teoM}", "amount": 40 }, "expect": { "status": 403 } },
    { "name": "the leader pays Teo", "as": "mira", "method": "POST", "path": "/api/teams/{team}/treasury/payout",
      "body": { "membershipId": "{teoM}", "amount": 40, "memo": "Bought escape orbs" }, "expect": { "status": 204 } },
    { "name": "the treasury can't go negative", "as": "mira", "method": "POST", "path": "/api/teams/{team}/treasury/payout",
      "body": { "membershipId": "{teoM}", "amount": 51 }, "expect": { "status": 422, "code": "ledger.insufficient-funds" } },
    { "name": "neither can a wallet", "as": "sol", "method": "POST", "path": "/api/teams/{team}/wallet/cash-out",
      "body": { "amount": 51 }, "expect": { "status": 422, "code": "ledger.insufficient-funds" } },

    { "name": "the leader can't just leave", "as": "mira", "method": "DELETE", "path": "/api/teams/{team}/members/{miraM}",
      "expect": { "status": 422, "code": "member.leader-cannot-leave" } },
    { "name": "Sol leaves; the wallet is cashed out", "as": "sol", "method": "DELETE", "path": "/api/teams/{team}/members/{solM}",
      "expect": { "status": 204 } },
    { "name": "Sol is gone", "as": "sol", "method": "GET", "path": "/api/teams/{team}", "expect": { "status": 404 } },
    { "name": "two remain", "as": "mira", "method": "GET", "path": "/api/teams/{team}/members",
      "expect": { "status": 200, "json": { "$#": 2, "$[1].wallet": 120 } } },
    { "name": "hand over the team", "as": "mira", "method": "POST", "path": "/api/teams/{team}/leadership",
      "body": { "membershipId": "{teoM}" }, "expect": { "status": 204 } },
    { "name": "the new leader demotes Mira", "as": "teo", "method": "PATCH", "path": "/api/teams/{team}/members/{miraM}",
      "body": { "role": "MEMBER" }, "expect": { "status": 204 } },
    { "name": "Mira's view", "as": "mira", "method": "GET", "path": "/api/teams/{team}",
      "expect": { "status": 200, "json": { "$.myRole": "MEMBER" } } },

    { "name": "reward transaction has seven legs", "as": "mira", "method": "GET",
      "path": "/api/teams/{team}/ledger?reason=MISSION_REWARD",
      "expect": { "status": 200, "json": { "$.total": 7 } } },
    { "name": "Sol's cash-out on leaving is on record", "as": "mira", "method": "GET",
      "path": "/api/teams/{team}/ledger?account=wallet:{solM}&reason=CASH_OUT",
      "expect": { "status": 200, "json": { "$.total": 1, "$.items[0].delta": -50, "$.items[0].balanceAfter": 0 } } },
    { "name": "the ledger reconciles", "as": "mira", "method": "GET", "path": "/api/teams/{team}/ledger/reconcile",
      "expect": { "status": 200, "json": { "$.ok": true, "$.problems#": 0 } } }
  ]
}
