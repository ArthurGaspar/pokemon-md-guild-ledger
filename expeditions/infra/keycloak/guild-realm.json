{
  "realm": "guild",
  "displayName": "Guild Expeditions",
  "enabled": true,
  "registrationAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "adventurer", "description": "Lines up for expeditions and joins parties" },
      { "name": "guild-staff", "description": "Publishes expeditions" }
    ]
  },
  "clients": [
    {
      "clientId": "expeditions",
      "name": "Guild Expeditions",
      "description": "Public client. Password grant is enabled for the demo script and the load test only; a browser client would use the authorization code flow with PKCE, also enabled.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["+"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ],
